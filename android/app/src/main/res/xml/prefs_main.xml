<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <androidx.preference.PreferenceCategory
    android:title="@string/settings"
    android:order="1">
    <androidx.preference.Preference
      android:key="@string/pref_storage"
      android:title="@string/maps_storage"
      android:order="1" />
    <androidx.preference.Preference
      android:key="@string/pref_map_locale"
      android:title="@string/pref_map_locale"
      android:order="2" />
    <androidx.preference.ListPreference
      android:key="@string/pref_map_style"
      android:title="@string/pref_map_style"
      android:entries="@array/map_style"
      android:defaultValue="default"
      android:order="3" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_3d"
      android:title="@string/pref_3d"
      android:defaultValue="true"
      android:order="4" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_3d_buildings"
      android:title="@string/pref_3d_buildings"
      android:defaultValue="true"
      android:dependency="@string/pref_3d"
      android:order="5" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_auto_zoom"
      android:title="@string/pref_auto_zoom"
      android:defaultValue="true"
      android:order="6" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_show_zoom_buttons"
      android:title="@string/pref_show_zoom_buttons"
      android:defaultValue="true"
      android:order="7" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_show_downloaded_regions"
      android:title="@string/pref_show_downloaded_regions"
      android:defaultValue="false"
      android:order="8" />
  </androidx.preference.PreferenceCategory>

  <androidx.preference.PreferenceCategory
    android:title="@string/prefs_routing"
    android:order="2">
    <androidx.preference.Preference
      android:key="@string/prefs_routing"
      android:title="@string/prefs_routing"
      android:order="1" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_autodownload"
      android:title="@string/pref_autodownload"
      android:defaultValue="true"
      android:order="2" />
  </androidx.preference.PreferenceCategory>

  <androidx.preference.PreferenceCategory
    android:title="@string/pref_tts_screen"
    android:order="3">
    <androidx.preference.Preference
      android:key="@string/pref_tts_screen"
      android:title="@string/pref_tts_screen"
      android:order="1" />
  </androidx.preference.PreferenceCategory>

  <androidx.preference.PreferenceCategory
    android:title="@string/measurement_units"
    android:order="4">
    <androidx.preference.ListPreference
      android:key="@string/pref_munits"
      android:title="@string/measurement_units"
      android:entries="@array/measument_units"
      android:entryValues="@array/measument_units_values"
      android:defaultValue="0"
      android:order="1" />
  </androidx.preference.PreferenceCategory>

  <androidx.preference.PreferenceCategory
    android:title="@string/pref_privacy"
    android:order="5">
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_search_history"
      android:title="@string/pref_search_history"
      android:defaultValue="true"
      android:order="1" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_play_services"
      android:title="@string/pref_play_services"
      android:defaultValue="true"
      android:order="2" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_settings_general"
      android:title="@string/pref_settings_general"
      android:defaultValue="true"
      android:order="3" />
  </androidx.preference.PreferenceCategory>

  <androidx.preference.PreferenceCategory
    android:title="@string/prefs_group_misc"
    android:order="6">
    <androidx.preference.ListPreference
      android:key="@string/pref_power_management"
      android:title="@string/pref_power_management"
      android:entries="@array/power_management_scheme"
      android:entryValues="@array/power_management_scheme_values"
      android:defaultValue="0"
      android:order="1" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_large_fonts_size"
      android:title="@string/pref_large_fonts_size"
      android:defaultValue="false"
      android:order="2" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_transliteration"
      android:title="@string/pref_transliteration"
      android:defaultValue="false"
      android:order="3" />
    <androidx.preference.ListPreference
      android:key="@string/pref_use_mobile_data"
      android:title="@string/pref_use_mobile_data"
      android:entries="@array/mobile_data_options"
      android:entryValues="@array/mobile_data_options_values"
      android:defaultValue="0"
      android:order="4" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_keep_screen_on"
      android:title="@string/pref_keep_screen_on"
      android:defaultValue="false"
      android:order="5" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_show_on_lock_screen"
      android:title="@string/pref_show_on_lock_screen"
      android:defaultValue="false"
      android:order="6" />
    <androidx.preference.ListPreference
        android:key="@string/pref_bookmarks_text_placement"
        android:title="@string/pref_bookmarks_text_placement"
        android:entries="@array/bookmarks_text_placement_options"
        android:entryValues="@array/bookmarks_text_placement_values"
        android:defaultValue="1"
        android:order="7" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_enable_logging"
      android:title="@string/pref_enable_logging"
      android:defaultValue="false"
      android:order="8" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_emulate_bad_external_storage"
      android:title="@string/pref_emulate_bad_external_storage"
      android:defaultValue="false"
      android:order="9" />
  </androidx.preference.PreferenceCategory>

  <androidx.preference.PreferenceCategory
    android:title="@string/pref_information"
    android:order="7">
    <androidx.preference.Preference
      android:key="@string/pref_help"
      android:title="@string/pref_help"
      android:order="1" />
    <androidx.preference.Preference
      android:key="@string/pref_about"
      android:title="@string/pref_about"
      android:order="2" />
  </androidx.preference.PreferenceCategory>

  <androidx.preference.PreferenceCategory
    android:key="@string/pref_wear_os"
    android:title="@string/prefs_group_wear_os"
    android:order="8">
    <androidx.preference.ListPreference
      android:key="@string/pref_wear_os_backend"
      android:title="@string/pref_wear_os_backend_title"
      android:summary="@string/pref_wear_os_backend_summary"
      app:singleLineTitle="false"
      android:entries="@array/wear_backend"
      android:entryValues="@array/wear_backend_values"
      android:defaultValue="GMS"
      android:order="1" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_wear_os_map_enabled"
      android:title="@string/pref_wear_map_enabled_title"
      android:summary="@string/pref_wear_map_enabled_summary"
      app:singleLineTitle="false"
      android:defaultValue="false"
      android:order="2" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_wear_os_standalone_mode"
      android:title="@string/pref_wear_os_standalone_mode_title"
      android:summary="@string/pref_wear_os_standalone_mode_summary"
      app:singleLineTitle="false"
      android:defaultValue="false"
      android:order="3" />
    <androidx.preference.SwitchPreferenceCompat
      android:key="@string/pref_wear_os_offline_maps_enabled"
      android:title="@string/pref_wear_os_offline_maps_title"
      android:summary="@string/pref_wear_os_offline_maps_summary"
      app:singleLineTitle="false"
      android:dependency="@string/pref_wear_os_map_enabled"
      android:order="4" />
    <androidx.preference.ListPreference
      android:key="@string/pref_wear_os_map_download_mode"
      android:title="@string/pref_wear_map_download_mode_title"
      app:singleLineTitle="false"
      android:entries="@array/wear_map_download_mode"
      android:entryValues="@array/wear_map_download_mode_values"
      android:defaultValue="BLUETOOTH_ONLY"
      android:dependency="@string/pref_wear_os_offline_maps_enabled"
      android:order="5" />
  </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>
