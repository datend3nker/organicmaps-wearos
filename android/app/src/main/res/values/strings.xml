    <!-- App Tips -->
    <string name="app_tip_00">Thank you for using our maps, created by the community!</string>
    <string name="app_tip_01">With your donations and support, we can create the best maps in the world!</string>
    <string name="app_tip_02">Do you like our app? Donate to support its development! Still don\'t like it? Please tell us why and we will fix it!</string>
    <string name="app_tip_03">If you know a clever software developer, ask them to implement a feature you need for the app.</string>
    <string name="app_tip_04">Tap anywhere on the map to select something. A long press hides and returns the interface.</string>
    <string name="app_tip_05">Did you know that your location on the map can be selected?</string>
    <string name="app_tip_06">You can help translate our app into your language.</string>
    <string name="app_tip_07">Our app is developed by a few enthusiasts and the community.</string>
    <string name="app_tip_08">You can easily fix and improve map data.</string>
    <string name="app_tip_09">Our main goal is to create fast, private, and easy-to-use maps that you will love.</string>

